#!/usr/bin/env bash
#
# declaudify - remove Claude attribution from a GitHub repo's history, and from
# the two places GitHub shows it.
#
# GitHub renders contributors from two independent caches, and they do not clear
# the same way:
#
#   Insights > Contributors   cleared by the force-push, a few minutes
#   Repo homepage sidebar     cleared by toggling the default branch, 60 to 80s
#
# A force-push alone leaves the homepage sidebar crediting Claude indefinitely:
# measured stale for 919 seconds with nothing else done to the repo. So this
# rewrites the history, force-pushes it, then flips the default branch away and
# back, and waits until both surfaces really come back clean.
#
# Your repository is never renamed, replaced or deleted. Stars, issues, pull
# requests, forks and settings all stay exactly where they are.
#
set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

DECLAUDIFY_VERSION=2.0.0

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")

# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
# shellcheck source=lib/rewrite.sh
source "$SELF_DIR/lib/rewrite.sh"

# --- hidden re-entry ---------------------------------------------------------
# filter-branch calls back into this script so commit messages and annotated tag
# messages go through the exact same filter. Handled before the GitHub layer is
# sourced because it runs once per commit and must stay cheap.
if [[ ${1:-} == --__filter-message ]]; then
    dc_filter_message
    exit 0
fi

# shellcheck source=lib/github.sh
source "$SELF_DIR/lib/github.sh"

# --- defaults ----------------------------------------------------------------

PREVIEW_LIMIT=10
WORKDIR=''
TARGET=''
NO_FLUSH=0
DECLAUDIFY_NEW_NAME=''
DECLAUDIFY_NEW_EMAIL=''

usage() {
    cat <<'EOF'
declaudify - remove Claude attribution from a GitHub repo

USAGE
    declaudify [options] <owner/repo | github url>

WHAT IT DOES
    Rewrites every commit message, author, committer, annotated tag message and
    tagger that credits Claude, across every branch and tag. Force-pushes the
    result to your repository, then flushes the homepage sidebar cache and waits
    until Claude is gone from both contributor lists GitHub shows.

    Your repository is never renamed, replaced or deleted. Stars, issues, pull
    requests, forks, releases and settings are untouched.

WHY THE EXTRA STEP
    GitHub has two contributor caches. The force-push clears Insights, but the
    repo homepage sidebar has its own cache that a push does not touch; it was
    measured still crediting Claude 919 seconds after a clean force-push.
    Toggling the default branch away and back clears it in about a minute, so
    declaudify does that for you.

OPTIONS
    -n, --dry-run          Clone and rewrite locally, show what would change,
                           and touch nothing on GitHub. Always run this first.
    -y, --yes              Skip confirmation prompts.
    -v, --verbose          Show every step instead of just the important ones.
        --no-flush         Skip the default-branch toggle. Insights will clear,
                           the homepage sidebar will not.
        --name <name>      Author name to reattribute Claude commits to.
        --email <email>    Author email to reattribute Claude commits to.
                           Both default to the repo's most frequent human author.
        --workdir <dir>    Working directory. Default is a timestamped folder
                           under ${XDG_CACHE_HOME:-~/.cache}/declaudify, which
                           keeps the pre-rewrite backup bundle.
        --drop-regex <re>  Override which message lines are deleted (lowercase ERE).
        --identity-regex <re>
                           Override which identities count as Claude (lowercase ERE).
        --fallback <text>  Subject for commits whose message was entirely Claude
                           boilerplate (default: "Update").
        --preview <n>      Message diffs to show before confirming (default: 10).
    -h, --help             This help.
    -V, --version          Version.

WHAT IT COSTS
    Commit SHAs change, so existing clones of the repo need re-cloning. That is
    the whole cost. Nothing is deleted and nothing is lost.

    Old commits do remain reachable by SHA and inside pull-request refs, which
    no force-push can reach. Neither feeds a contributor list, so Claude will not
    appear anywhere GitHub renders contributors, but the objects are still there.

REQUIREMENTS
    git, curl, awk, and an authenticated gh with push access. Admin rights are
    needed only for the default-branch toggle that clears the homepage sidebar.
EOF
}

# --- argument parsing --------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--dry-run)      DECLAUDIFY_DRY_RUN=1 ;;
        -y|--yes)          DECLAUDIFY_ASSUME_YES=1 ;;
        -v|--verbose)      DECLAUDIFY_VERBOSE=1 ;;
        --no-flush)        NO_FLUSH=1 ;;
        --name)            DECLAUDIFY_NEW_NAME=${2:?--name needs a value}; shift ;;
        --email)           DECLAUDIFY_NEW_EMAIL=${2:?--email needs a value}; shift ;;
        --workdir)         WORKDIR=${2:?--workdir needs a value}; shift ;;
        --drop-regex)      DECLAUDIFY_DROP_RE=${2:?--drop-regex needs a value}; shift ;;
        --identity-regex)  DECLAUDIFY_IDENT_RE=${2:?--identity-regex needs a value}; shift ;;
        --fallback)        DECLAUDIFY_FALLBACK=${2:?--fallback needs a value}; shift ;;
        --preview)         PREVIEW_LIMIT=${2:?--preview needs a value}; shift ;;
        -h|--help)         usage; exit 0 ;;
        -V|--version)      printf 'declaudify %s\n' "$DECLAUDIFY_VERSION"; exit 0 ;;
        -*)                die "unknown option: $1 (try --help)" ;;
        *)                 [[ -z $TARGET ]] || die "unexpected argument: $1"; TARGET=$1 ;;
    esac
    shift
done

[[ -n $TARGET ]] || { usage >&2; die "no repository given"; }
export DECLAUDIFY_DRY_RUN DECLAUDIFY_ASSUME_YES DECLAUDIFY_VERBOSE

# Accept owner/name, https://github.com/owner/name(.git), git@github.com:owner/name.git
parse_repo() {
    local raw=$1
    raw=${raw%.git}
    raw=${raw#https://github.com/}
    raw=${raw#http://github.com/}
    raw=${raw#git@github.com:}
    raw=${raw#ssh://git@github.com/}
    raw=${raw%/}
    [[ $raw == */* && $raw != */*/* ]] || die "expected owner/repo, got: $1"
    printf '%s' "$raw"
}

REPO=$(parse_repo "$TARGET")
OWNER=${REPO%%/*}
NAME=${REPO##*/}

# --- failure handling --------------------------------------------------------

on_exit() {
    local code=$?
    trap - EXIT
    if (( code != 0 )) && [[ -n ${WORKDIR:-} && -f $WORKDIR/backup.bundle ]]; then
        say ''
        warn "your original history is preserved at:"
        say "        $WORKDIR/backup.bundle"
        say "    restore it with:"
        say "        git clone --mirror $WORKDIR/backup.bundle restored.git"
        say "        git -C restored.git push --force https://github.com/$REPO.git 'refs/heads/*:refs/heads/*'"
    fi
    exit "$code"
}
trap on_exit EXIT

# =============================================================================
# Preflight
# =============================================================================

need_cmd git
need_cmd awk
need_cmd curl "needed to read the repo homepage sidebar"
gh_preflight
detail "git $(git --version | awk '{print $3}'), gh authenticated"

gh_repo_exists "$REPO" || die "repository not found or not visible to you: $REPO"

DEFAULT_BRANCH=$(gh_repo_field "$REPO" '.default_branch')
VISIBILITY=$(gh_repo_field "$REPO" '.visibility')
IS_ARCHIVED=$(gh_repo_field "$REPO" '.archived')
IS_ADMIN=$(gh_repo_field "$REPO" '.permissions.admin')
CAN_PUSH=$(gh_repo_field "$REPO" '.permissions.push')
CLONE_URL=$(gh_repo_field "$REPO" '.clone_url')

detail "$REPO ($VISIBILITY, default branch: $DEFAULT_BRANCH)"

[[ $IS_ARCHIVED == true ]] && die "$REPO is archived, so it cannot be pushed to. Unarchive it first."
[[ $CAN_PUSH == true ]] || die "you need push access to $REPO"

# The sidebar flush toggles the default branch, which is an admin-only setting.
CAN_FLUSH=1
if (( NO_FLUSH )); then
    CAN_FLUSH=0
elif [[ $IS_ADMIN != true ]]; then
    CAN_FLUSH=0
    warn "you are not an admin of $REPO, so the default branch cannot be toggled."
    warn "Insights will clear, but the homepage sidebar will keep listing Claude."
fi

# =============================================================================
# Clone
# =============================================================================

if [[ -z $WORKDIR ]]; then
    WORKDIR="${XDG_CACHE_HOME:-$HOME/.cache}/declaudify/${OWNER}-${NAME}-$(date +%Y%m%d-%H%M%S)"
fi
mkdir -p "$WORKDIR"
MIRROR="$WORKDIR/mirror.git"

step "$REPO"
[[ -e $MIRROR ]] && die "$MIRROR already exists"
git clone --quiet --mirror "$CLONE_URL" "$MIRROR"
detail "mirror clone at $MIRROR"

# Back up everything the server gave us, refs/pull/* included, before touching
# anything.
git -C "$MIRROR" bundle create "$WORKDIR/backup.bundle" --all >/dev/null 2>&1
git -C "$MIRROR" for-each-ref --format='%(refname) %(objectname)' > "$WORKDIR/refs-before.txt"
detail "backup bundle: $WORKDIR/backup.bundle"

# Only branches, tags and notes are ours to rewrite. refs/pull/* is read-only on
# GitHub and the push would be rejected.
pruned=$(dc_prune_foreign_refs "$MIRROR")
(( pruned > 0 )) && detail "ignored $pruned ref(s) outside refs/heads, refs/tags, refs/notes"

SNAP_BEFORE=$(dc_snapshot "$MIRROR")
BRANCHES=$(git -C "$MIRROR" for-each-ref --format='%(refname)' refs/heads | wc -l | tr -d ' ')
TAGS=$(git -C "$MIRROR" for-each-ref --format='%(refname)' refs/tags | wc -l | tr -d ' ')
COMMITS=$(git -C "$MIRROR" rev-list --all --count)
REPO_SIZE="$(plural "$COMMITS" commit), $(plural "$BRANCHES" branch branches), $(plural "$TAGS" tag)"
say "    $VISIBILITY, $REPO_SIZE"

# =============================================================================
# Scan
# =============================================================================

dc_scan "$MIRROR"
detail "messages: $DC_SCAN_MSG_COUNT, identities: $DC_SCAN_IDENT_COUNT, tags: $DC_SCAN_TAG_COUNT"

# A repo can have a perfectly clean history and still be credited to Claude,
# because both contributor caches lag behind the git data. Check them before
# concluding there is nothing to do.
SIDEBAR_NOW=$(gh_sidebar_contributors "$REPO" | tr '\n' ' ' || true)
GRAPH_NOW=$(gh api "repos/$REPO/stats/contributors" --jq '[.[].author.login] | join(" ")' 2>/dev/null || true)
STALE_LISTING=0
dc_list_has_claude "$SIDEBAR_NOW" && STALE_LISTING=1
dc_list_has_claude "$GRAPH_NOW"   && STALE_LISTING=1

if (( DC_SCAN_TOTAL == 0 && ! STALE_LISTING )); then
    ok "no Claude attribution in the history or the contributor lists. Nothing to do."
    exit 0
fi

if (( DC_SCAN_TOTAL > 0 )); then
    say "    found $(plural "$DC_SCAN_TOTAL" item) to rewrite"
else
    say ''
    warn "The history is already clean, but GitHub still credits Claude:"
    [[ -n $SIDEBAR_NOW ]] && warn "  homepage sidebar: $SIDEBAR_NOW"
    [[ -n $GRAPH_NOW   ]] && warn "  insights:         $GRAPH_NOW"
    warn "This run will refresh both."
fi

# =============================================================================
# Rewrite
# =============================================================================

# Reattribution identity: the repo's most frequent non-Claude author.
if [[ -z $DECLAUDIFY_NEW_NAME || -z $DECLAUDIFY_NEW_EMAIL ]]; then
    top=$(git -C "$MIRROR" log --all --format='%an <%ae>' |
          grep -viE "$(dc_ident_re)" | sort | uniq -c | sort -rn | head -1 |
          sed 's/^ *[0-9]* //') || true
    if [[ -n ${top:-} ]]; then
        [[ -n $DECLAUDIFY_NEW_NAME ]]  || DECLAUDIFY_NEW_NAME=${top%% <*}
        [[ -n $DECLAUDIFY_NEW_EMAIL ]] || { DECLAUDIFY_NEW_EMAIL=${top##*<}; DECLAUDIFY_NEW_EMAIL=${DECLAUDIFY_NEW_EMAIL%>}; }
    fi
    [[ -n $DECLAUDIFY_NEW_NAME ]]  || DECLAUDIFY_NEW_NAME=$(git config user.name || echo "$OWNER")
    [[ -n $DECLAUDIFY_NEW_EMAIL ]] || DECLAUDIFY_NEW_EMAIL=$(git config user.email || echo "$OWNER@users.noreply.github.com")
fi
export DECLAUDIFY_NEW_NAME DECLAUDIFY_NEW_EMAIL
if (( DC_SCAN_IDENT_COUNT > 0 )); then
    say "    reattributing to $DECLAUDIFY_NEW_NAME <$DECLAUDIFY_NEW_EMAIL>"
else
    detail "reattribution identity: $DECLAUDIFY_NEW_NAME <$DECLAUDIFY_NEW_EMAIL>"
fi

if (( PREVIEW_LIMIT > 0 && DC_SCAN_MSG_COUNT > 0 )); then
    say ''
    say "    ${C_BOLD}lines that will be removed${C_RESET} (first $PREVIEW_LIMIT affected commits):"
    dc_preview "$MIRROR" "$PREVIEW_LIMIT"
fi

if (( DC_SCAN_TOTAL > 0 )); then
    dc_rewrite_commits "$MIRROR" "$SELF"
    detail "commit messages and identities rewritten"
    tags_done=$(dc_rewrite_tags "$MIRROR")
    detail "$tags_done annotated tag(s) rebuilt"
    dropped=$(dc_drop_original_refs "$MIRROR")
    detail "dropped $dropped refs/original backup ref(s)"
    dc_gc "$MIRROR"
else
    detail "history needs no rewriting; refreshing the listings only"
fi

# --- integrity gate ---
# A history rewrite must change metadata and nothing else. If any ref's tree or
# commit count moved, something ate real content, so stop before pushing.
SNAP_AFTER=$(dc_snapshot "$MIRROR")
if [[ $(printf '%s\n' "$SNAP_BEFORE" | awk '{print $1, $2, $3}') != \
      $(printf '%s\n' "$SNAP_AFTER"  | awk '{print $1, $2, $3}') ]]; then
    say ''
    diff <(printf '%s\n' "$SNAP_BEFORE") <(printf '%s\n' "$SNAP_AFTER") >&2 || true
    die "file content or commit count changed during rewrite, refusing to push"
fi
detail "content verified identical: every ref has the same tree and commit count"

left_attr=$(dc_residual_attribution_count "$MIRROR")
left_ident=$(dc_residual_identity_count "$MIRROR")
(( left_attr == 0 ))  || die "$left_attr attribution line(s) survived the rewrite, refusing to push"
(( left_ident == 0 )) || die "$left_ident commit(s) are still attributed to Claude, refusing to push"
detail "no attribution lines and no Claude identities remain"

residual=$(dc_residual_count "$MIRROR")
(( residual > 0 )) && detail "$residual line(s) mention claude/anthropic in prose or a human name, left alone"

# =============================================================================
# Confirm
# =============================================================================

step "This rewrites $REPO in place"
say "    force-push  $REPO_SIZE to $OWNER/$NAME"
(( CAN_FLUSH )) && say "    then flip the default branch away and back to refresh the sidebar"
say "    nothing is renamed, replaced or deleted; stars and issues stay put"
say ''
say "    ${C_YELLOW}Commit SHAs change,${C_RESET} so existing clones will need re-cloning."
say "    ${C_DIM}Old commits stay reachable by SHA and in pull-request refs, but${C_RESET}"
say "    ${C_DIM}neither feeds a contributor list.${C_RESET}"

if [[ $DECLAUDIFY_DRY_RUN == 1 ]]; then
    step "Dry run: nothing on GitHub was touched"
    say "    Rewritten mirror: $MIRROR"
    say "    Backup bundle:    $WORKDIR/backup.bundle"
    say "    Re-run without --dry-run to do it for real."
    exit 0
fi

confirm "Rewrite $REPO?" "$NAME"

# =============================================================================
# Push and verify
# =============================================================================

step "Rewriting"
PUSH_URL="https://github.com/$REPO.git"
git -C "$MIRROR" push --force --quiet "$PUSH_URL" 'refs/heads/*:refs/heads/*' ||
    die "push failed; $REPO is unchanged"
git -C "$MIRROR" push --force --quiet "$PUSH_URL" 'refs/tags/*:refs/tags/*' 2>/dev/null || true
ok "force-pushed $REPO_SIZE"

VERIFY="$WORKDIR/verify.git"
rm -rf "$VERIFY"
git clone --quiet --mirror "$PUSH_URL" "$VERIFY"
dc_prune_foreign_refs "$VERIFY" >/dev/null

if [[ $(dc_snapshot "$VERIFY") != "$SNAP_AFTER" ]]; then
    diff <(printf '%s\n' "$SNAP_AFTER") <(dc_snapshot "$VERIFY") >&2 || true
    die "the pushed history does not match the local rewrite"
fi
if [[ $(printf '%s\n' "$SNAP_BEFORE" | awk '{print $1, $2, $3}') != \
      $(dc_snapshot "$VERIFY" | awk '{print $1, $2, $3}') ]]; then
    die "file content changed during the rewrite"
fi
(( $(dc_residual_attribution_count "$VERIFY") == 0 )) || die "attribution still present on GitHub"
(( $(dc_residual_identity_count "$VERIFY") == 0 ))    || die "Claude identities still present on GitHub"
ok "verified on GitHub: content identical, no Claude attribution on any branch"

# =============================================================================
# Refresh the contributor listings
# =============================================================================

if (( CAN_FLUSH )); then
    step "Flushing the homepage sidebar cache"
    if gh_flush_sidebar_cache "$REPO" "$DEFAULT_BRANCH"; then
        ok "default branch toggled and restored"
    else
        CAN_FLUSH=0
        warn "could not toggle the default branch."
        warn "To do it by hand: Settings > General > Default branch, switch it to"
        warn "any other branch, save, then switch it back to $DEFAULT_BRANCH."
    fi
fi

step "Waiting for GitHub to recompute"
say "    ${C_BOLD}Do not push or change settings until this finishes.${C_RESET}"
say "    ${C_DIM}Insights takes a few minutes; the sidebar about a minute after the toggle.${C_RESET}"

t0=$(date +%s)
graph_done=0 sidebar_done=0
for _ in $(seq 1 "${DECLAUDIFY_GRAPH_TRIES:-90}"); do
    elapsed=$(( $(date +%s) - t0 ))

    if (( ! graph_done )); then
        graph=$(gh api "repos/$REPO/stats/contributors" \
                --jq '[.[].author.login] | join(" ")' 2>/dev/null || true)
        if [[ -n $graph ]] && ! dc_list_has_claude "$graph"; then
            ok "Insights contributors clean after ${elapsed}s ($graph)"
            graph_done=1
        else
            detail "${elapsed}s insights: ${graph:-recomputing}"
        fi
    fi

    if (( ! sidebar_done )); then
        sidebar=$(gh_sidebar_contributors "$REPO" | tr '\n' ' ' || true)
        if [[ -n $sidebar ]] && ! dc_list_has_claude "$sidebar"; then
            ok "homepage sidebar clean after ${elapsed}s ($sidebar)"
            sidebar_done=1
        else
            detail "${elapsed}s sidebar:  ${sidebar:-unreadable}"
        fi
    fi

    (( graph_done && sidebar_done )) && break
    sleep 10
done

if (( ! graph_done || ! sidebar_done )); then
    say ''
    (( graph_done )) || warn "Insights had not settled yet when this stopped watching."
    if (( ! sidebar_done )); then
        if (( CAN_FLUSH )); then
            warn "The homepage sidebar had not settled yet when this stopped watching."
        else
            warn "The homepage sidebar was not flushed, so it will keep listing Claude."
            warn "Toggle the default branch in Settings and back to clear it."
        fi
    fi
    warn "Re-check with:"
    say "        gh api repos/$REPO/stats/contributors --jq '[.[].author.login]'"
    say "        open https://github.com/$REPO"
fi

step "Done"
say "    https://github.com/$REPO has $COMMITS commits with no Claude attribution."
say "    Backup: $WORKDIR/backup.bundle"
say "    Re-clone local copies: git clone $PUSH_URL"
